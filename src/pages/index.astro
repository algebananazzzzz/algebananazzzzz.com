---
import Base from '@/layouts/Base.astro';
import nowRaw from '@/content/now.yaml';
import aboutRaw from '@/content/about.yaml';
import Splash from '@/components/island/Splash';
import Orbit from '@/components/island/Orbit';
import Orrery from '@/components/island/Orrery';
import CareerList from '@/components/island/CareerList';
import MottoRotator from '@/components/static/MottoRotator.astro';
import { getCareerEntries } from '@/lib/getCareerEntries';
import { getOrrery } from '@/lib/getOrrery';

type NowItem = {
  title: string;
  note: string;
  tags: string[];
};

type NowData = {
  developing: NowItem;
  exploring: NowItem;
  obsessed: NowItem;
};

const nowData = nowRaw as NowData;

type AboutData = { heroSub: string };
const about = aboutRaw as AboutData;

const { orrery } = await getOrrery();

const careerEntries = await getCareerEntries(3);

// Dot colours match the developing and exploring planets in Orbit.tsx.
const orbitingTopics = [
  { kind: 'developing', label: nowData.developing.title, dotColor: '#fbbf24' },
  { kind: 'exploring', label: nowData.exploring.title, dotColor: '#a78bfa' },
];
---

<Base isHome={true}>
  <Splash client:load />

  <!-- Hero proper -->
  <section class="hero hero-single" data-screen-label="01 Hero" data-accent="cosmic">
    <div class="hero-content">
      <div class="eyebrow">my personal portfolio site</div>
      <h2 class="hero-greeting">
        Welcome to my <em>nebula</em>.
      </h2>
      <p class="hero-sub">
        {about.heroSub}
      </p>

      <MottoRotator />

      <div class="hero-ctas">
        <a href="/about" class="cta-secondary">About Me</a>
        <a href="/starmap" class="cta-starmap" aria-label="enter the starmap">
          <span class="cta-star"></span>
          <span class="cta-label">Enter the Starmap</span>
          <svg
            class="cta-arrow"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="orbiting">
        <span class="label">currently orbiting</span>
        {
          orbitingTopics.map((t) => (
            <span class="orbiting-chip" title={t.kind}>
              <span class="dot" style={`background:${t.dotColor};color:${t.dotColor}`} />
              {t.label}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Now (orbit) -->
  <section class="section" data-screen-label="02 Now" data-accent="aurora">
    <div class="section-head">
      <div>
        <div class="eyebrow">what i'm doing now</div>
        <h2 class="section-title">Current <em>Orbit</em></h2>
      </div>
      <a href="/about" class="section-link">more about me →</a>
    </div>
    <Orbit
      client:idle
      developing={nowData.developing}
      exploring={nowData.exploring}
      obsessed={nowData.obsessed}
    />
  </section>

  <!-- Projects -->
  <section class="section" data-screen-label="03 Projects" data-accent="sunset">
    <div class="section-head">
      <div>
        <div class="eyebrow">projects, mapped by stack</div>
        <h2 class="section-title">Project <em>Orrery</em>.</h2>
      </div>
      <a href="/projects" class="section-link">all projects →</a>
    </div>
    <Orrery client:visible mode="compact" data={orrery} />
  </section>

  <!-- Career -->
  <section class="section" data-screen-label="04 Experience" data-accent="nebula">
    <div class="section-head">
      <div>
        <div class="eyebrow">where I've been</div>
        <h2 class="section-title">Past <em>Trajectory</em></h2>
      </div>
      <a href="/experience" class="section-link">full timeline →</a>
    </div>
    <CareerList client:visible entries={careerEntries} />
  </section>
</Base>
